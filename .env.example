# Copy to .env and adjust. All values are optional; defaults are in scripts/lib.sh.

# Pinned Waze version whose patch assets are baked into build/assets (default hardcoded in
# lib.sh). Bumping it alone is not enough: the smali anchors and Pins.java must be updated
# together (see DEVELOPMENT.md §11).
# WAZE_VERSION=5.23.0.2

# APK download source for the host-side asset build: apk-pure (default, no credentials) or
# google-play.
# APK_SOURCE=apk-pure

# fetch-apk and decompile skip their work when their outputs already exist. Set FORCE=1 (usually
# inline, e.g. `FORCE=1 scripts/all.sh`) to re-download and re-decompile from scratch.
# FORCE=1

# google-play only: an account email + AAS token (see apkeep USAGE-google-play.md).
# GOOGLE_EMAIL=someone@gmail.com
# AAS_TOKEN=xxxxxxxx
